FROM node:24.22.1-trixie-slim AS package-manager
ENV COREPACK_HOME=/opt/corepack-cache
RUN corepack prepare yarn@4.17.0 --activate

FROM node:26.12.1-trixie-slim AS build
COPY --from=package-manager /opt/corepack-cache/v1/yarn/4.17.0/yarn.js /opt/yarn.cjs
WORKDIR /isolated-vm
RUN apt-get update && apt-get install -y --no-install-recommends g++ make python3 && rm -rf /var/lib/apt/lists/*
COPY package.json yarn.lock .yarnrc.yml ./
RUN node /opt/yarn.cjs install --immutable --mode=skip-build
COPY . .
RUN node /opt/yarn.cjs prebuild

FROM scratch
COPY --from=build /isolated-vm/prebuilds .
