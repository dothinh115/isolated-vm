{
  "name": "@enfyra/isolated-vm",
  "version": "7.0.4",
  "description": "Access to multiple isolates",
  "main": "isolated-vm.js",
  "types": "isolated-vm.d.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install": "node-gyp-build 'node-gyp rebuild -j 4 --release -v' || node-gyp rebuild --release -j max",
    "prebuild": "node scripts/run-prebuild.js",
    "rebuild": "node-gyp rebuild --release -j max",
    "lint": "find src -name '*.cc' | xargs -n1 clang-tidy",
    "test": "node scripts/test-timer-queue.js && node test.js",
    "test:timer-queue": "node scripts/test-timer-queue.js"
  },
  "dependencies": {
    "node-gyp": "^11.2.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dothinh115/isolated-vm.git"
  },
  "author": "https://github.com/laverdet/",
  "license": "ISC",
  "gypfile": true,
  "bugs": {
    "url": "https://github.com/dothinh115/isolated-vm/issues"
  },
  "homepage": "https://github.com/dothinh115/isolated-vm#readme",
  "publishConfig": {
    "access": "public"
  }
}
